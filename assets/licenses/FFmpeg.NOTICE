e,pcm_s8,pcm_s8_planar,pcm_sga,pcm_u16be,pcm_u16le,pcm_u24be,pcm_u24le,pcm_u32be,pcm_u32le,pcm_u8,pcm_vidc,qcelp,qdm2,qdmc,qoa,ra_144,ra_288,ralf,roq_dpcm,sbc,sdx2_dpcm,shorten,sipr,siren,smackaud,sol_dpcm,sonic,tak,truehd,truespeech,tta,twinvq,vmdaudio,vorbis,wady_dpcm,wavarc,wavpack,wmalossless,wmapro,wmav1,wmav2,wmavoice,ws_snd1,xan_dpcm,xma1,xma2' --disable-demuxer='concat,hls,dash,imf,webm_dash_manifest,ffmetadata,mpl2,tedcaptions,image2,image2_alias_pix,image2_brender_pix,image2pipe,image_bmp_pipe,image_cri_pipe,image_dds_pipe,image_dpx_pipe,image_exr_pipe,image_gem_pipe,image_gif_pipe,image_hdr_pipe,image_j2k_pipe,image_jpeg_pipe,image_jpegls_pipe,image_jpegxl_pipe,image_jpegxs_pipe,image_pam_pipe,image_pbm_pipe,image_pcx_pipe,image_pfm_pipe,image_pgm_pipe,image_pgmyuv_pipe,image_pgx_pipe,image_phm_pipe,image_photocd_pipe,image_pictor_pipe,image_png_pipe,image_ppm_pipe,image_psd_pipe,image_qdraw_pipe,image_qoi_pipe,image_sgi_pipe,image_sunrast_pipe,image_svg_pipe,image_tiff_pipe,image_vbn_pipe,image_webp_pipe,image_xbm_pipe,image_xpm_pipe,image_xwd_pipe' --enable-pic --enable-static --disable-shared --target-os=darwin --arch=arm64 --enable-cross-compile -sdk macosx clang' --extra-cflags='-arch arm64 -mmacosx-version-min=13.3' --extra-ldflags='-arch arm64 -mmacosx-version-min=13.3'
